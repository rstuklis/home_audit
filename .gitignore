# Audit data saved by the script at runtime — never commit these
~/.home_net_audit/
.home_net_audit/

# Raw output from tools/capture_fixtures.py. It holds the capturing machine's
# SSID, BSSIDs, LAN MACs and account name — and holds them unredacted whenever
# --raw was used. The workflow is deliberately two-step: capture here, read it,
# then copy the files you have checked into tests/fixtures/. Ignoring this
# directory is what stops step two being skipped by accident.
captured/

# Local scan output files
*.json
*.log
*.txt
audit_report_*.html

# Test-suite files that the broad *.txt / *.json rules above would otherwise
# swallow. Captured command-output fixtures use .out precisely to stay clear of
# those rules; these negations cover the two tracked files that cannot.
!requirements-dev.txt
!tests/fixtures/*.json

# Python
__pycache__/
*.py[cod]

# Test artifacts
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# macOS
.DS_Store

# Environment / secrets
.env
.env.*
